# =====================================================
# FRONTEND (Vite) — copy this file to .env and fill in
# =====================================================

# Supabase project (find in Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- Payment provider switch -------------------------
# Which provider is LIVE. Both are in the codebase; only this one runs.
#   cashfree (default) | razorpay
VITE_PAYMENT_PROVIDER=cashfree

# Cashfree's sandbox/production mode is driven by the server's
# CASHFREE_ENV (see below) and returned to the browser per order, so
# there is no separate frontend mode var to keep in sync.

# ---- Razorpay (kept for fallback) --------------------
# Only used when VITE_PAYMENT_PROVIDER=razorpay. The live key id is
# returned by the create-order function, so this is optional.
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx


# =====================================================
# EDGE FUNCTION SECRETS — set via Supabase CLI:
#
#   # Cashfree (active)
#   supabase secrets set CASHFREE_APP_ID=xxxxxxxxxxxx
#   supabase secrets set CASHFREE_SECRET_KEY=cfsk_xxxxxxxx
#   supabase secrets set CASHFREE_ENV=sandbox            # or: production
#   supabase secrets set SITE_URL=https://your-domain.com  # for return_url
#
#   # Razorpay (fallback — only needed if you switch back)
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxx
#   supabase secrets set RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected
# by Supabase into edge functions — you don't set them.
#
# NOTE: Cashfree's webhook is signed with CASHFREE_SECRET_KEY (there is
# no separate webhook secret). Configure the webhook URL in the Cashfree
# dashboard → Developers → Webhooks:
#   https://YOUR_PROJECT_REF.supabase.co/functions/v1/cashfree-webhook
# =====================================================
